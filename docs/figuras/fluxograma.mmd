%% Fluxograma do sistema (Tarefa 4). Implementado: contorno contínuo.
%% Pendente (Etapa 5): contorno tracejado e fundo cinza. Opcional: tracejado sem fundo.
flowchart TD
    A([Estudante escreve o código<br/>ou escolhe um dos 7 exemplos]) --> B{Frontend: entrada válida?<br/>não vazia, não só espaços,<br/>até 20 000 caracteres}
    B -->|não| B1[/Aviso no editor<br/>nenhuma requisição enviada/]
    B1 --> A
    B -->|sim| C[POST /api/analisar<br/>Nginx repassa ao backend]
    C --> D{Backend: JSON e<br/>campo codigo válidos?}
    D -->|não| D1[/HTTP 400, 413 ou 422<br/>mensagem de validação/]
    D1 --> A
    D -->|sim| E[Análise léxica — scanner<br/>tokens, NOVA_LINHA, INDENT, DEDENT,<br/>erros e avisos léxicos, passos]
    E --> F{Há erro léxico?}
    F -->|sim| G[Decisão: o parser NÃO é executado<br/>sintatico.executado = false e motivo]
    G --> G1[/Retorno de erro léxico:<br/>tokens válidos + erros com linha e coluna/]
    F -->|não| H[Análise sintática — parser<br/>descendente recursivo, 15 regras EBNF]
    H --> I{Há erro sintático?}
    I -->|sim| J[Recuperação: inserção de ':'<br/>e modo pânico até a próxima linha<br/>no máximo 50 erros]
    J --> J1[/Retorno de erro sintático:<br/>encontrado, esperado, regra, produção;<br/>AST nula; passos até o erro/]
    I -->|não| K[Constrói AST e árvore de derivação<br/>registra passos do parser]
    K --> S1[[Análise semântica<br/>tipos, declaração antes do uso — Etapa 5]]
    S1 --> S2[[Tabela de símbolos<br/>nome, tipo, linha, escopo — Etapa 5]]
    S2 --> S3{{Erro semântico? — Etapa 5}}
    S3 -.->|sim| S4[/Retorno de erro semântico — Etapa 5/]
    S3 -.->|não| M[/Resultado completo:<br/>tokens + AST + derivação + passos/]
    K -->|hoje| M
    G1 --> O[Apresentação na interface:<br/>tabela de tokens, código colorido, árvore,<br/>passo a passo, lista de erros com destaque]
    J1 --> O
    S4 -.-> O
    M --> O
    O -.->|opcional| P[Assistente de IA: backend reanalisa,<br/>monta o contexto e consulta Ollama / Llama 3.2]
    P -.-> O
    classDef pendente fill:#eeeeee,stroke:#777,stroke-dasharray:6 4,color:#444
    classDef opcional stroke-dasharray:4 3
    classDef erro fill:#fff3f0,stroke:#b03a2e
    class S1,S2,S3,S4 pendente
    class P opcional
    class B1,D1,G1,J1 erro
